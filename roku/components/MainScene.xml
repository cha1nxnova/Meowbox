<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Rectangle id="backdrop" width="1280" height="720" color="0x000000FF" />

    <Video id="video" width="1280" height="720" enableUI="false" />
    <Audio id="music" />

    <!-- cards between shows, and the "tuning" card -->
    <Group id="card" visible="false">
      <Rectangle width="1280" height="720" color="0x0B0B14FF" />
      <Rectangle id="cardStripe" width="1280" height="10" color="0x888888FF" />
      <Label id="cardChannel" translation="[60, 44]" width="1160" color="0xFFFFFFAA" font="font:MediumBoldSystemFont" />
      <Label id="cardText" translation="[110, 150]" width="1060" height="380" wrap="true" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" lineSpacing="10">
        <Font role="font" uri="font:BoldSystemFontFile" size="46" />
      </Label>
      <Label id="cardSub" translation="[110, 560]" width="1060" height="120" wrap="true" horizAlign="center" color="0xFFFFFF99" font="font:SmallSystemFont" />
    </Group>

    <!-- what is on, over the bottom of the picture -->
    <Group id="banner" visible="false" translation="[0, 500]">
      <Rectangle width="1280" height="220" color="0x000000D0" />
      <Rectangle id="bannerStripe" width="8" height="220" color="0x888888FF" />
      <Label id="bannerChannel" translation="[40, 16]" width="1200" color="0xFFFFFFCC" font="font:MediumBoldSystemFont" />
      <Label id="bannerTitle" translation="[40, 54]" width="1200" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Label id="bannerTime" translation="[40, 100]" width="1200" color="0xFFFFFFAA" font="font:SmallSystemFont" />
      <Label id="bannerBlurb" translation="[40, 134]" width="1200" height="70" wrap="true" maxLines="2" color="0xFFFFFF99" font="font:SmallSystemFont" />
    </Group>

    <!-- channel guide -->
    <Group id="guide" visible="false">
      <Rectangle width="500" height="720" color="0x0D0E16F2" />
      <Label translation="[40, 30]" text="CHANNELS" color="0xFFFFFF99" font="font:MediumBoldSystemFont" />
      <LabelList id="guideList" translation="[30, 80]" itemSize="[440, 44]" numRows="13" vertFocusAnimationStyle="floatingFocus" />
      <Rectangle translation="[500, 0]" width="780" height="300" color="0x0D0E16D8" />
      <Rectangle id="guideStripe" translation="[500, 0]" width="780" height="8" color="0x888888FF" />
      <Label id="guideName" translation="[540, 34]" width="700" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Label id="guideDesc" translation="[540, 84]" width="700" height="100" wrap="true" maxLines="3" color="0xFFFFFFAA" font="font:SmallSystemFont" />
      <Label id="guideNow" translation="[540, 196]" width="700" color="0xFFFFFFFF" font="font:MediumSystemFont" />
      <Label id="guideNext" translation="[540, 240]" width="700" color="0xFFFFFF99" font="font:SmallSystemFont" />
    </Group>

    <!-- options menu -->
    <Group id="menu" visible="false">
      <Rectangle translation="[420, 170]" width="440" height="380" color="0x12131CF5" />
      <Label translation="[450, 190]" text="MEOWBOX" color="0xFFFFFF99" font="font:MediumBoldSystemFont" />
      <LabelList id="menuList" translation="[440, 240]" itemSize="[400, 48]" numRows="6" />
    </Group>

    <BrowserView id="browser" visible="false" />

    <Label id="toast" translation="[40, 20]" width="1200" visible="false" color="0xFFFFFFCC" font="font:SmallSystemFont" />

    <Timer id="tick" repeat="true" duration="0.25" />
  </children>
</component>
