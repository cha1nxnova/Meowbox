<?xml version="1.0" encoding="utf-8" ?>
<!--
  The background worker for the TV side. It owns the lineup and the schedule
  maths; the screen sends it small requests and gets small plain answers.

  request  { cmd: "lineup" }
           { cmd: "tune",  channelId, at, seq }     at: "" for now, or a time in ms as text
           { cmd: "peek",  channelId, seq }
           { cmd: "blurb", channelId, version, videoIndex, key }
           { cmd: "find",  id, seq }                look up a playable file for a tape
           { cmd: "save",  key, value }
-->
<component name="BroadcastTask" extends="Task">
  <interface>
    <field id="request" type="assocarray" alwaysNotify="true" />
    <field id="lineup" type="assocarray" alwaysNotify="true" />
    <field id="onAir" type="assocarray" alwaysNotify="true" />
    <field id="peek" type="assocarray" alwaysNotify="true" />
    <field id="blurb" type="assocarray" alwaysNotify="true" />
    <field id="found" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/engine.brs" />
  <script type="text/brightscript" uri="pkg:/source/broadcast.brs" />
  <script type="text/brightscript" uri="pkg:/source/net.brs" />
  <script type="text/brightscript" uri="pkg:/components/BroadcastTask.brs" />
</component>
