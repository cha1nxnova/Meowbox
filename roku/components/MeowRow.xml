<?xml version="1.0" encoding="utf-8" ?>
<!--
  One row of the channel guide or the menu.
  itemContent: title, and optionally dial (text), chip (a colour), value (text at the right).
-->
<component name="MeowRow" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="fill" />
    <field id="width" type="float" onChange="place" />
    <field id="height" type="float" />
    <field id="focusPercent" type="float" onChange="glow" />
    <field id="listHasFocus" type="boolean" onChange="glow" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/MeowRow.brs" />
  <children>
    <Rectangle id="bar" width="456" height="46" color="0xFFA630FF" opacity="0" />
    <Label id="dial" translation="[8, 8]" width="58" horizAlign="right" color="0xFFA630FF">
      <Font role="font" uri="pkg:/fonts/Jersey15.ttf" size="28" />
    </Label>
    <Rectangle id="chip" translation="[78, 9]" width="6" height="28" color="0x3A3157FF" />
    <Label id="title" translation="[98, 7]" width="250" color="0xF6EEDDFF">
      <Font role="font" uri="pkg:/fonts/Jersey15.ttf" size="30" />
    </Label>
    <Label id="value" translation="[0, 11]" width="150" horizAlign="right" color="0xA99FBFFF">
      <Font role="font" uri="pkg:/fonts/Jersey15.ttf" size="22" />
    </Label>
  </children>
</component>
