' ---------------------------------------------------------------------------
' Captions without a captioning service. Nothing here listens to the sound:
' it finds words somebody has already written down and lines them up.
'
'   1. The website's own subtitle files (English for the tapes that are not
'      in English), listed in an index the lineup points at.
'   2. Caption files sitting next to the video on the Internet Archive:
'      ones people uploaded, and the ones the Archive's own speech
'      recognition made (*.asr.srt, *.autogenerated.vtt).
'
' Everything in this file is plain text-in, records-out, so it can be
' exercised off-device (see tests/).
'
' A cue is { t0, t1, text }: milliseconds into the file, and what to show.
' ---------------------------------------------------------------------------

' The name the website files a tape's subtitles under. Mirrors the site: a
' playlist item that names its "file" is keyed by tape and file, one that
' does not is keyed by the tape alone.
function CapTapeKey(id as String, file as String) as String
    if file = "" then return id
    s = CreateObject("roRegex", "\.[^.]+$", "").ReplaceAll(file, "")
    s = CreateObject("roRegex", "[^A-Za-z0-9]+", "").ReplaceAll(s, "-")
    s = CreateObject("roRegex", "^-+|-+$", "").ReplaceAll(s, "")
    return id + "/" + Left(s, 120)
end function

' "00:01:02,5" / "01:02.500" / "1:02:03.45" as milliseconds, -1 when it is not a time
function CapTimeMs(s as String) as Integer
    hit = CreateObject("roRegex", "^(?:(\d+):)?(\d{1,2}):(\d{1,2})(?:[.,](\d{1,3}))?$", "").Match(s.Trim())
    if hit.Count() < 4 then return -1
    h = 0
    if hit[1] <> "" then h = hit[1].ToInt()
    ms = 0
    if hit.Count() > 4
        frac = hit[4]
        if frac <> ""
            ' ",5" is half a second and ",05" a twentieth, whatever the digit count
            while Len(frac) < 3
                frac = frac + "0"
            end while
            ms = frac.ToInt()
        end if
    end if
    return ((h * 60 + hit[2].ToInt()) * 60 + hit[3].ToInt()) * 1000 + ms
end function

' one caption's text, with markup taken out and at most three lines kept
function CapClean(lines as Object) as String
    tags = CreateObject("roRegex", "<[^>]*>|\{\\[^}]*\}", "")
    keep = []
    for each raw in lines
        t = tags.ReplaceAll(raw, "")
        if Instr(1, t, "&") > 0
            t = t.Replace("&nbsp;", " ").Replace("&lt;", "<").Replace("&gt;", ">").Replace("&quot;", Chr(34)).Replace("&#39;", "'").Replace("&amp;", "&")
        end if
        t = t.Trim()
        if t <> "" then keep.Push(t)
    end for
    while keep.Count() > 3
        keep.Shift()
    end while
    return keep.Join(Chr(10))
end function

' SubRip and WebVTT are close enough to read with one pass: a line with an
' arrow starts a cue, and its text runs to the next blank line.
function CapParseTimed(body as String) as Object
    cues = []
    if Len(body) = 0 then return cues
    body = body.Replace(Chr(13), "")
    lines = body.Split(Chr(10))
    n = lines.Count()
    space = CreateObject("roRegex", "\s+", "")
    digits = CreateObject("roRegex", "^\s*\d+\s*$", "")
    sorted = true
    last = -1
    i = 0
    while i < n
        line = lines[i]
        at = Instr(1, line, "-->")
        i = i + 1
        if at > 0
            t0 = CapTimeMs(CapLastWord(Left(line, at - 1), space))
            rest = space.Split(Mid(line, at + 3).Trim())
            t1 = -1
            if rest.Count() > 0 then t1 = CapTimeMs(rest[0])
            text = []
            ' a line holding only a space is part of a rolling caption, not its end
            while i < n
                if Len(lines[i]) = 0 then exit while
                if Instr(1, lines[i], "-->") > 0
                    ' ran into the next cue: the line before it was that cue's number
                    if text.Count() > 0
                        if digits.IsMatch(text[text.Count() - 1]) then text.Pop()
                    end if
                    exit while
                end if
                text.Push(lines[i])
                i = i + 1
            end while
            ' cues under a twentieth of a second are the "settling" frames of
            ' roll-up captions: showing them would only make the text flicker
            if t0 >= 0 and t1 - t0 >= 50
                shown = CapClean(text)
                if shown <> ""
                    if t1 - t0 > 12000 then t1 = t0 + 12000
                    if t0 < last then sorted = false
                    last = t0
                    cues.Push({ t0: t0, t1: t1, text: shown })
                end if
            end if
        end if
    end while
    if not sorted then cues.SortBy("t0")
    return cues
end function

function CapLastWord(s as String, space as Object) as String
    parts = space.Split(s.Trim())
    if parts.Count() = 0 then return ""
    return parts[parts.Count() - 1]
end function

' The website's subtitle file: { format: 1, file, cues: [{ t0, t1, kind, en }] }
' kind is "line" (speech), "beat" (a bracketed note) or "mark" (words nobody could place).
function CapFromSite(j as Dynamic) as Object
    cues = []
    if type(j) <> "roAssociativeArray" then return cues
    if j.cues = invalid then return cues
    sorted = true
    last = -1
    for each c in j.cues
        ok = (type(c) = "roAssociativeArray")
        if ok then ok = (CapWhole(c.t0) and CapWhole(c.t1) and c.kind <> invalid)
        if ok then ok = (c.t1 > c.t0)
        if ok
            text = ""
            if c.kind = "mark"
                text = "[...]"
            else if c.kind = "line" or c.kind = "beat"
                if c.en <> invalid then text = c.en.Trim()
            end if
            if text <> ""
                if c.t0 < last then sorted = false
                last = c.t0
                cues.Push({ t0: Int(c.t0), t1: Int(c.t1), text: text })
            end if
        end if
    end for
    if not sorted then cues.SortBy("t0")
    return cues
end function

function CapWhole(x as Dynamic) as Boolean
    t = type(x)
    if t = "Integer" or t = "roInt" or t = "roInteger" or t = "LongInteger" then return x >= 0
    if t = "Float" or t = "roFloat" or t = "Double" or t = "roDouble" then return x >= 0 and x = Int(x)
    return false
end function

' Which cue is showing at this moment: an index into cues, or -1.
' Cues may overlap; the one that started last wins, as on the website.
function CapCueAt(cues as Object, ms as Integer) as Integer
    lo = 0
    hi = cues.Count() - 1
    found = -1
    while lo <= hi
        half = (lo + hi) \ 2
        if cues[half].t0 <= ms
            found = half
            lo = half + 1
        else
            hi = half - 1
        end if
    end while
    if found < 0 then return -1
    if ms < cues[found].t1 then return found
    return -1
end function

' ---- the Internet Archive -----------------------------------------------------------

' the part of a video's file name its caption files share
function CapStems(video as String) as Object
    stem = CreateObject("roRegex", "\.[^./]+$", "").ReplaceAll(video, "")
    out = [stem]
    for each tail in [".ia", "_512kb", "_h264"]
        if LCase(Right(stem, Len(tail))) = tail then out.Push(Left(stem, Len(stem) - Len(tail)))
    end for
    return out
end function

' From an Archive metadata answer's file list, the caption file that belongs
' to this video: { name, machine } or invalid.
' Written by a person beats written by a machine; English beats anything else.
function CapPickArchive(files as Dynamic, video as String) as Dynamic
    if files = invalid or video = "" then return invalid
    stems = CapStems(video)
    lang = CreateObject("roRegex", "\.([a-z]{2,3})(?:-[a-z]{2,4})?$", "i")
    best = invalid
    bestScore = 9999
    for each f in files
        name = f.name
        if name <> invalid
            ext = LCase(Right(name, 4))
            if ext = ".srt" or ext = ".vtt"
                tail = ""
                rank = 0
                for each stem in stems
                    if tail = ""
                        if Len(name) > Len(stem) + 4 and Left(name, Len(stem) + 1) = stem + "."
                            tail = LCase(Mid(name, Len(stem) + 1, Len(name) - Len(stem) - 4))
                        else if Len(name) = Len(stem) + 4 and Left(name, Len(stem)) = stem
                            tail = "."
                        else
                            rank = rank + 1
                        end if
                    end if
                end for
                ' ".disc.srt" files are disc menus read as text, and a few
                ' hundred bytes is not a transcript
                size = 100000
                if type(f.size) = "roString" or type(f.size) = "String" then size = f.size.ToInt()
                if tail <> "" and Instr(1, tail, ".disc") = 0 and size >= 500
                    machine = (Instr(1, tail, "asr") > 0 or Instr(1, tail, "auto") > 0)
                    score = rank
                    if machine then score = score + 20
                    if Instr(1, tail, "autogenerated") > 0 then score = score + 10
                    if ext = ".vtt" then score = score + 2
                    words = tail.Replace(".asr", "").Replace(".autogenerated", "")
                    hit = lang.Match(words)
                    if hit.Count() > 1
                        code = LCase(hit[1])
                        if code <> "en" and code <> "eng" and code <> "cc5" then score = score + 100
                    end if
                    if score < bestScore
                        bestScore = score
                        best = { name: name, machine: machine }
                    end if
                end if
            end if
        end if
    end for
    return best
end function

' what to tell the viewer about where the words came from
function CapCredit(source as String) as String
    if source = "site-machine" then return "Subtitles by machine, from spelunkr.tv"
    if source = "site-archive" then return "Subtitles from spelunkr.tv"
    if source = "ia-machine" then return "Machine-made captions from the Internet Archive"
    if source = "ia-person" then return "Captions from the Internet Archive"
    return ""
end function
