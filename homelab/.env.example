# Copy to .env (never commit .env: it holds passwords).
TZ=America/Chicago

# MQTT login shared by Mosquitto, govee2mqtt and Home Assistant.
MQTT_USER=meow
MQTT_PASSWORD=change-me

# Govee: the account you use in the Govee Home app.
GOVEE_EMAIL=
GOVEE_PASSWORD=
# Govee Home app > Profile > Settings > Apply for API Key (emailed to you).
GOVEE_API_KEY=

# ---- media profile only ----
MEDIA_DIR=/srv/media
DOWNLOADS_DIR=/srv/downloads
VPN_SERVICE_PROVIDER=mullvad
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_SERVER_COUNTRIES=USA
