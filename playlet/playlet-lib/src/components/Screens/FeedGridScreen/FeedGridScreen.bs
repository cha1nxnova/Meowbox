import "pkg:/source/utils/Logging.bs"
import "pkg:/source/utils/RemoteKeys.bs"
import "pkg:/source/utils/Types.bs"

' What each side-bar section shows.
function FeedGridPresets() as object
    return {
        "subscriptions": {
            title: "Subscriptions"
            hint: "Newest videos from the channels you follow"
            empty: "Nothing here yet. Sign in under Profile, and subscribe to a few channels."
            cell: "video"
            feedSources: [{ id: "inv_auth_feed", title: "Subscriptions", apiType: "Invidious", endpoint: "auth_feed" }]
        }
        "channels": {
            title: "Channels"
            hint: "Every channel you follow, A to Z. Hold OK on one to pin it to the top."
            empty: "No channels yet. Sign in under Profile, and subscribe to a few channels."
            cell: "channel"
            feedSources: [{ id: "inv_auth_subscriptions", title: "Channels", apiType: "Invidious", endpoint: "auth_subscriptions" }]
        }
        "history": {
            title: "History"
            hint: "Tapes from Meowbox TV first, then YouTube"
            empty: "No watch history yet. Watch something on Meowbox TV, or sign in under Profile."
            cell: "video"
            feedSources: [
                { id: "meowbox_tv_history", title: "Meowbox TV", apiType: "Invidious", endpoint: "meowbox_tv_history" }
                { id: "inv_auth_history", title: "Watch history", apiType: "Invidious", endpoint: "watch_history" }
            ]
        }
    }
end function

function Init()
    m.top.focusable = true
    m.grid = m.top.findNode("grid")
    m.refreshButton = m.top.findNode("refreshButton")
    m.titleLabel = m.top.findNode("titleLabel")
    m.hintLabel = m.top.findNode("hintLabel")
    m.emptyState = m.top.findNode("emptyState")
    m.emptyLabel = m.top.findNode("emptyLabel")
    m.pendingJob = invalid
    m.isDirty = true
    m.seenMarked = false
end function

function OnNodeReady()
    m.config = FeedGridPresets()[m.top.preset]
    if m.config = invalid
        m.config = FeedGridPresets()["subscriptions"]
    end if

    m.titleLabel.text = Tr(m.config.title)
    m.hintLabel.text = Tr(m.config.hint)
    m.emptyLabel.text = Tr(m.config.empty)
    m.refreshButton.text = Tr(Locale.Buttons.Refresh)

    if m.config.cell = "channel"
        ' 196px channel cards: five across
        m.grid.itemSize = [196, 318]
        m.grid.itemSpacing = [25, 40]
        m.grid.numColumns = 5
    else
        ' 350px video cards: three across
        m.grid.itemSize = [350, 318]
        m.grid.itemSpacing = [25, 40]
        m.grid.numColumns = 3
    end if

    SetNavigation(invalid, RemoteKeys.Back, m.navBar)
    SetNavigation(m.refreshButton, RemoteKeys.Left, m.navBar)
    SetNavigation(m.grid, RemoteKeys.Left, m.navBar)
    SetNavigation(m.grid, RemoteKeys.Up, m.refreshButton)
    SetNavigation(m.refreshButton, RemoteKeys.Down, m.grid)

    InitializeLongPress(["OK"])
    m.refreshButton.observeField("buttonSelected", FuncName(OnRefreshSelected))
    m.grid.observeField("itemFocused", FuncName(OnItemFocused))
    ' OK starts the long-press timer; letting go early is a plain select (see OnKeyEvent)
    m.grid.observeField("itemSelected", FuncName(OnGridOkPressed))
    m.top.observeField("visible", FuncName(OnVisibleChange))
    m.profilesService.observeFieldScoped("currentProfileChanged", FuncName(OnProfileChanged))

    OnVisibleChange()
end function

' Loads on first show, and again after a profile change while hidden.
function OnVisibleChange()
    if m.top.visible and m.isDirty
        Reload(false)
    end if
end function

function OnProfileChanged()
    m.isDirty = true
    OnVisibleChange()
end function

function Refresh(_unused as dynamic)
    Reload(true)
end function

function OnRefreshSelected()
    Reload(true)
end function

function Reload(fresh = false as boolean) as void
    m.isDirty = false
    CancelJob()

    feedSources = []
    for each preset in m.config.feedSources
        feedSource = {}
        feedSource.Append(preset)
        ' A refresh asks the server again instead of the disk cache.
        feedSource.noCache = fresh
        feedSource.state = { loadState: FeedLoadState.None }
        feedSources.Push(feedSource)
    end for
    m.seenMarked = false

    m.holder = CreateObject("roSGNode", "ContentNode")
    feed = m.holder.createChild("FeedContentNode")
    feed.title = m.config.title
    feed.feedSourcesIndex = 0
    feed.loadState = FeedLoadState.None
    feed.feedSources = feedSources
    for i = 1 to m.grid.numColumns
        feed.createChild("LoadingContentNode")
    end for

    m.feed = feed
    m.emptyState.visible = false
    m.grid.visible = true
    m.grid.focusable = true
    m.grid.content = feed
    m.grid.jumpToItem = 0
    LoadMore()
end function

function LoadMore() as void
    if m.pendingJob <> invalid or m.feed = invalid
        return
    end if
    state = m.feed.loadState
    if state <> FeedLoadState.None and state <> FeedLoadState.LoadedPage
        return
    end if

    m.feed.loadState = FeedLoadState.Loading
    input = {
        rowList: m.top
        feedContentNode: m.feed
        invidious: m.invidious
    }
    m.pendingJob = JobSystem.CreateCallback(OnLoadDone)
    JobSystem.QueueJob(m.jobQueue, Jobs.VideoRowListRowContentJob, input, m.pendingJob)
end function

function CancelJob()
    if m.pendingJob <> invalid
        m.pendingJob.cancel = true
        m.pendingJob = invalid
    end if
end function

function OnLoadDone(event as object) as void
    JobSystem.UnobserveCallback(event.getRoSGNode())
    if m.pendingJob = invalid or not m.pendingJob.isSameNode(event.getRoSGNode())
        return
    end if
    m.pendingJob = invalid

    if event.getInfo().cancel
        return
    end if

    ' The job drops a feed it can not load because nobody is signed in.
    removed = m.feed.getParent() = invalid
    hasItems = false
    if not removed
        for each child in m.feed.getChildren(-1, 0)
            if ValidString(child.type) <> "loading"
                hasItems = true
                exit for
            end if
        end for
    end if

    if not hasItems and (removed or m.feed.loadState = FeedLoadState.Loaded or m.feed.loadState = FeedLoadState.Error)
        m.feed.removeChildrenIndex(m.feed.getChildCount(), 0)
        ShowEmpty()
        return
    end if

    MarkSubscriptionsSeen()

    ' Fill the screen before waiting for the user to scroll.
    if m.feed.getChildCount() < m.grid.numColumns * 3
        LoadMore()
    end if
end function

function ShowEmpty()
    m.emptyState.visible = true
    m.grid.visible = false
    m.grid.focusable = false
    if m.grid.isInFocusChain()
        NodeSetFocus(m.refreshButton, true)
    end if
end function

function OnItemFocused() as void
    if m.feed = invalid
        return
    end if
    ' Two rows from the end: fetch the next page
    if m.grid.itemFocused >= m.feed.getChildCount() - m.grid.numColumns * 2
        LoadMore()
    end if
end function

function OnGridOkPressed()
    LongPressHandler(RemoteKeys.Ok, true)
end function

function ItemAt(index as integer) as object
    if m.feed = invalid or index < 0 or index >= m.feed.getChildCount()
        return invalid
    end if
    item = m.feed.getChild(index)
    if ValidString(item.type) = "loading"
        return invalid
    end if
    return item
end function

function OnItemSelected() as void
    item = ItemAt(m.grid.itemSelected)
    if item = invalid
        return
    end if

    if MeowboxTvUtils.IsTape(item)
        MeowboxTvUtils.Open(item, m.appController)
    else if item.type = "video"
        LogInfo("Play video: " + item.videoId)
        m.videoQueue.playVideo = item
    else if item.type = "playlist"
        PlaylistUtils.Open(item)
    else if item.type = "channel"
        ChannelUtils.Open(item)
    end if
end function

function OnFocusChange() as void
    if not m.top.focus
        return
    end if
    if m.grid.visible
        NodeSetFocus(m.grid, true)
    else
        NodeSetFocus(m.refreshButton, true)
    end if
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    ' Same long-press dance as VideoRowList: OK down came through itemSelected
    if not (key = RemoteKeys.Ok and press)
        if LongPressHandler(key, press)
            return true
        end if
    end if
    if key = RemoteKeys.OkLongPress and press
        OpenContextMenu(ItemAt(m.grid.itemFocused))
        return true
    end if
    if key = RemoteKeys.Ok and not press
        if m.grid.isInFocusChain()
            OnItemSelected()
        end if
        return true
    end if

    if NavigationKeyHandler(key, press).handled
        return true
    end if
    ' Instant replay (the curved arrow) refreshes from anywhere on the screen.
    if key = RemoteKeys.Replay and press
        Reload(true)
        return true
    end if
    return false
end function

' ---- long-press menu ------------------------------------------------------------

function OpenContextMenu(item as object) as void
    if item = invalid
        return
    end if
    providers = [m.top]
    if not MeowboxTvUtils.IsTape(item)
        providers.Push(m.bookmarksService)
    end if
    ContextMenuUtils.Open(providers, m.appController, item)
end function

function GetContextMenuOptionsForItem(item as object) as object
    options = []
    if MeowboxTvUtils.IsTape(item)
        options.Push(ContextMenuUtils.CreateOption("Watch on Meowbox TV", m.top, "PlayItem", [item]))
    else if item.type = "video"
        options.Push(ContextMenuUtils.CreateOption(Tr(Locale.ContextMenu.PlayVideo), m.top, "PlayItem", [item]))
        options.Push(ContextMenuUtils.CreateOption(Tr(Locale.ContextMenu.QueueVideo), m.top, "QueueItem", [item]))
        if not StringUtils.IsNullOrEmpty(item.authorId)
            options.Push(ContextMenuUtils.CreateOption(Tr(Locale.ContextMenu.OpenChannel), m.top, "OpenItemChannel", [item]))
        end if
    else if item.type = "channel"
        options.Push(ContextMenuUtils.CreateOption(Tr(Locale.ContextMenu.OpenChannel), m.top, "OpenItemChannel", [item]))
        if MeowboxStore.IsPinned(item.authorId)
            options.Push(ContextMenuUtils.CreateOption("Unpin from the top", m.top, "SetPinned", [item, false]))
        else
            options.Push(ContextMenuUtils.CreateOption("Pin to the top", m.top, "SetPinned", [item, true]))
        end if
    end if
    return options
end function

function PlayItem(item as object)
    if MeowboxTvUtils.IsTape(item)
        MeowboxTvUtils.Open(item, m.appController)
    else
        m.videoQueue.playVideo = item
    end if
end function

function QueueItem(item as object)
    m.videoQueue@.FuncAddToQueueVideo(item)
end function

function OpenItemChannel(item as object)
    if item.type = "channel"
        ChannelUtils.Open(item)
    else
        ChannelUtils.Open(InvidiousContent.ToChannelContentNode(invalid, { authorId: item.authorId }))
    end if
end function

function SetPinned(item as object, pinned as boolean)
    MeowboxStore.SetPinned(item.authorId, pinned)
    Reload(true)
end function

' ---- new in subscriptions --------------------------------------------------------

' Opening Subscriptions clears the dot in the side bar.
function MarkSubscriptionsSeen() as void
    if m.top.preset <> "subscriptions" or m.seenMarked or m.feed = invalid or m.subscriptionsWatcher = invalid
        return
    end if
    ids = []
    for each child in m.feed.getChildren(20, 0)
        if ValidString(child.type) = "video" and not StringUtils.IsNullOrEmpty(child.videoId)
            ids.Push(child.videoId)
        end if
    end for
    if ids.Count() > 0
        m.seenMarked = true
        m.subscriptionsWatcher.seen = ids
    end if
end function
