<component name="HomeScreen" extends="Group" includes="AutoBind,Focus,ContextMenuProvider">
    <interface>
        <field id="navBar" type="node" bind="/NavBar" />
        <field id="invidious" type="node" bind="/Invidious" />
        <field id="preferences" type="node" bind="/Preferences" />
        <field id="watchProgress" type="node" bind="/MeowboxWatchProgress" />
        <field id="feedFile" type="string" value="libpkg:/config/default_home_layout.yaml" />
        <function name="RefreshFeedsFromMenu" />
        <function name="ForgetProgress" />
    </interface>
    <children>
        <!-- Meowbox: Up from the first row reaches it; Instant replay works too -->
        <ButtonEx
            id="refreshButton"
            iconUri="pkg:/images/icons/refresh.png"
            iconWidth="26"
            iconHeight="26"
            height="44"
            padding="[16,16]"
            anchor="[1,0]"
            translation="[1190,10]" />
        <VideoRowList
            itemComponentName="RowCell"
            id="rowList"
            translation="[0,50]"
            numRows="2"
            rowitemSize="[[350,318]]"
            rowItemSpacing="[[25,0]]"
            itemSize="[1280,326]"
            itemSpacing="[0,65]"
            rowLabelOffset="[[90,20]]"
            focusXOffset="[90]"
            showRowLabel="[true]"
            rowFocusAnimationStyle="floatingfocus"
            variableWidthItems="true"
            focusBitmapUri="pkg:/images/focus-glow-padding-30.$$RES$$.9.png"
        />
    </children>
</component>