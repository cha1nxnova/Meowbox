import "pkg:/components/Dialog/DialogUtils.bs"
import "pkg:/source/utils/FocusManagement.bs"
import "pkg:/source/utils/RemoteKeys.bs"

function Init()
    m.top.focusable = true
    m.tv = invalid
end function

function OnNodeReady()
end function

function Start(_unused as dynamic) as void
    ' MeowTV comes with the combined package only (Meowbox-Playlet.zip)
    ' named through a variable: MeowTV is not part of this library, so the
    ' build can not check it (and it is absent from Playlet on its own)
    tvComponent = "MeowTV"
    m.tv = CreateObject("roSGNode", tvComponent)
    if m.tv = invalid
        m.appController@.PopScreen()
        DialogUtils.ShowDialogEx({
            title: "Meowbox TV"
            message: "The Meowbox television is not in this package. Install Meowbox-Playlet.zip to watch it here."
        })
        return
    end if

    ' one picture at a time
    m.videoQueue.closePlayer = true
    m.tv.startChannel = m.top.channelId
    m.top.appendChild(m.tv)
    m.tv.active = true
    NodeSetFocus(m.tv, true)
end function

function OnFocusChange() as void
    if m.top.focus and m.tv <> invalid
        NodeSetFocus(m.tv, true)
    end if
end function

function OnKeyEvent(key as string, press as boolean) as boolean
    ' Keys the television did not use. Back leaves it.
    if key = RemoteKeys.Back and press
        Close()
        return true
    end if
    ' Everything else stays here, away from Playlet's own handlers
    return true
end function

function Close()
    if m.tv <> invalid
        m.tv.active = false
        m.top.removeChild(m.tv)
        m.tv = invalid
    end if
    m.appController@.PopScreen()
end function
