' Note: we use aliases and not references to sub cells that we initialize on Init() because
'       of a rare bug / race condition where the cells are not initialized
function OnContentSet() as void
    content = m.top.itemContent

    visibleProperties = {
        "video": "videoRowCellVisible"
        "playlist": "playlistRowCellVisible"
        "channel": "channelRowCellVisible"
        "loading": "loadingRowCellVisible"
    }

    contentProperties = {
        "video": "videoRowCellItemContent"
        "playlist": "playlistRowCellItemContent"
        "channel": "channelRowCellItemContent"
        "loading": "loadingRowCellItemContent"
    }

    if content = invalid
        for each key in visibleProperties
            m.top[visibleProperties[key]] = false
        end for
        m.top.loadingRowCellVisible = true
        return
    end if

    m.top.type = content.type

    visibleSet = false
    for each key in visibleProperties
        shouldBeVisible = content.type = key
        m.top[visibleProperties[key]] = shouldBeVisible
        if shouldBeVisible
            m.top[contentProperties[key]] = content
            visibleSet = true
        end if
    end for

    if not visibleSet
        m.top.loadingRowCellVisible = true
    end if

    if m.top.loadingRowCellVisible
        m.top.loadingRowCellIndex = m.top.index
    end if
end function

' The focused card turns white (SmartTube style). The RowList tells each item component about focus
' through rowListHasFocus / rowHasFocus / rowFocusPercent / itemHasFocus / focusPercent.
' Depending on the focus animation, either itemHasFocus or focusPercent is the first to change, so
' each handler trusts the field that triggered it (same approach as ProfileRowListCell).
function OnItemHasFocusChange()
    SetCardFocused(m.top.itemHasFocus)
end function

function OnFocusPercentChange()
    SetCardFocused(m.top.focusPercent > 0.5)
end function

function OnFocusStateChange()
    SetCardFocused(m.top.itemHasFocus or m.top.focusPercent > 0.5)
end function

function SetCardFocused(itemFocused as boolean)
    rowFocused = m.top.rowHasFocus or m.top.rowFocusPercent > 0.5
    cardFocused = itemFocused and rowFocused and m.top.rowListHasFocus

    m.top.videoRowCellCardFocused = cardFocused
    m.top.playlistRowCellCardFocused = cardFocused
    m.top.channelRowCellCardFocused = cardFocused
end function
